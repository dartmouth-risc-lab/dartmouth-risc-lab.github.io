---
import { getEntry } from "astro:content";
import BaseLayout from "@components/base/BaseLayout.astro";

const entry = await getEntry("outreach", "outreach");
const outreach = entry?.data.outreach ?? [];

outreach.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<BaseLayout title="Outreach">
  <section class="container py-10">
    <h1 class="text-5xl font-bold mb-12 text-center">Outreach</h1>

    <div class="space-y-5 max-w-5xl mx-auto">
      {outreach.map((item) => (
        <article class="border-b border-border dark:border-darkmode-border pb-5">
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2">
            {item.link ? (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xl font-semibold hover:underline"
              >
                {item.title}
              </a>
            ) : (
              <h2 class="text-xl font-semibold">{item.title}</h2>
            )}

            <span class="text-sm opacity-70">
              {new Date(item.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </span>
          </div>

          {item.event && (
            <p class="mt-1 text-sm font-semibold opacity-80">
              {item.event}
            </p>
          )}

          {item.description && (
            <p class="mt-2 text-sm leading-relaxed opacity-80">
              {item.description}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>