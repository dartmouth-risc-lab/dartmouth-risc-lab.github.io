---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@components/base/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL;

const software = (await getCollection("software", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Software">
  <section class="container py-10">
    <h1 class="text-5xl font-bold mb-4 text-center">Software</h1>
    <p class="text-center opacity-80 mb-12 max-w-3xl mx-auto">
      Open-source tools built by the RISc Lab.
    </p>

    <div class="space-y-16 max-w-5xl mx-auto">
      {software.map(({ id, data }) => (
        <article id={id} class="border-b border-border dark:border-darkmode-border pb-12">
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2">
            <h2 class="text-3xl font-bold">{data.title}</h2>
            {data.tagline && (
              <span class="text-sm uppercase tracking-wide opacity-70">{data.tagline}</span>
            )}
          </div>

          {data.image && (
            <Image
              src={data.image}
              alt={data.imageAlt}
              class="mt-6 w-full rounded-lg"
            />
          )}

          {data.description && (
            <p class="mt-6 text-lg leading-relaxed">{data.description}</p>
          )}

          <div class="mt-6 flex flex-wrap gap-3">
            {data.docs && (
              <a href={data.docs} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-txt-p px-4 py-2 text-sm font-semibold text-bg-p transition hover:opacity-80 dark:bg-darkmode-txt-p dark:text-darkmode-bg-p">
                Documentation
              </a>
            )}
            {data.github && (
              <a href={data.github} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-txt-p px-4 py-2 text-sm font-semibold transition hover:bg-bg-s dark:border-darkmode-txt-p dark:hover:bg-darkmode-bg-s">
                GitHub
              </a>
            )}
            {data.pypi && (
              <a href={data.pypi} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-txt-p px-4 py-2 text-sm font-semibold transition hover:bg-bg-s dark:border-darkmode-txt-p dark:hover:bg-darkmode-bg-s">
                PyPI
              </a>
            )}
          </div>

          {data.features.length > 0 && (
            <div class="mt-10">
              <h3 class="text-2xl font-semibold mb-4">What it renders</h3>
              <div class="grid gap-4 md:grid-cols-2">
                {data.features.map((feature) => (
                  <div class="rounded-lg border border-border dark:border-darkmode-border p-4">
                    <p class="font-semibold">{feature.name}</p>
                    <p class="mt-1 text-sm opacity-80">{feature.text}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {data.install && (
            <div class="mt-10">
              <h3 class="text-2xl font-semibold mb-4">Installation</h3>
              <pre class="rounded-lg bg-slate-900 text-slate-100 px-4 py-3 overflow-x-auto"><code>{data.install}</code></pre>
              {data.requirements && (
                <p class="mt-3 text-sm opacity-80">Requires {data.requirements}</p>
              )}
            </div>
          )}

          {data.papers.length > 0 && (
            <div class="mt-10">
              <h3 class="text-2xl font-semibold mb-4">Papers implemented</h3>
              <ul class="space-y-2">
                {data.papers.map((paper) => (
                  <li>
                    {paper.slug ? (
                      <a href={`${baseUrl}publications/${paper.slug}`} class="font-semibold hover:underline">
                        {paper.title}
                      </a>
                    ) : (
                      <span class="font-semibold">{paper.title}</span>
                    )}
                    {paper.venue && <span class="opacity-70">, {paper.venue}</span>}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
