---
import { getCollection, getEntry } from "astro:content";

const manualNewsEntry = await getEntry("news", "news");
const manualNews = (manualNewsEntry?.data.news ?? []).map((item) => ({
  date: item.date,
  type: "Update",
  title: item.title,
  link: "/news/",
  priority: 1,
}));

const awardsEntry = await getEntry("awards", "awards");
const awards = (awardsEntry?.data.awards ?? []).map((item) => ({
  date: item.date,
  type: "Award",
  title: item.recipient ? `${item.title} — ${item.recipient}` : item.title,
  link: "/awards/",
  priority: 2,
}));


const outreachEntry = await getEntry("outreach", "outreach");
const outreach = (outreachEntry?.data.outreach ?? []).map((item) => ({
  date: item.date,
  type: "Outreach",
  title: item.title,
  link: "/outreach/",
  priority: 3,
}));

const presentationsEntry = await getEntry("presentations", "presentations");
const presentations = (presentationsEntry?.data.presentations ?? []).map((item) => ({
  date: item.date,
  type: "Presentation",
  title: item.presenter ? `${item.title} — ${item.presenter}` : item.title,
  link: "/presentations/",
  priority: 4,
}));

// Papers at the same conference and year (e.g. "SIGGRAPH Asia 2026") share one
// news item. Venue strings vary ("ACM Transactions on Graphics (SIGGRAPH Asia 2026)",
// "SIGGRAPH Asia 2026 Conference Track"), so group on the conference name + year.
const conferenceKey = (venue = "") =>
  venue.match(/\b(SIGGRAPH Asia|SIGGRAPH|EGSR|ICCP|CVPR|ICCV|ECCV|ICRA|IROS|3DV) \d{4}\b/)?.[0];
const numberWords = ["", "One", "Two", "Three", "Four", "Five", "Six"];

const publicationGroups = new Map();
for (const entry of await getCollection("publications")) {
  const paper = {
    date: entry.data.date,
    title: entry.data.title,
    venue: entry.data.venue,
    // Project page when there is one, otherwise the paper's own page on this site.
    link: entry.data.projectPage || `/publications/${entry.id.split("/").pop()}/`,
  };
  const key = conferenceKey(entry.data.venue) ?? entry.id;
  publicationGroups.set(key, [...(publicationGroups.get(key) ?? []), paper]);
}

const publications = [...publicationGroups.entries()].map(([key, papers]) =>
  papers.length === 1
    ? {
        date: papers[0].date,
        type: "Publication",
        title: papers[0].venue ? `${papers[0].title} — ${papers[0].venue}` : papers[0].title,
        link: papers[0].link,
        priority: 5,
      }
    : {
        date: papers.map((p) => p.date).filter(Boolean).sort((a, b) => b - a)[0],
        type: "Publication",
        title: `${numberWords[papers.length] ?? papers.length} papers at ${key}`,
        papers,
        priority: 5,
      }
);

const patentsEntry = await getEntry("patents", "patents");
const patents = (patentsEntry?.data.patents ?? []).map((item) => ({
  date: item.date,
  type: "Patent",
  title: item.title,
  link: "/patents/",
  priority: 6,
}));

const allNews = [
  ...manualNews,
  ...awards,
  ...outreach,
  ...presentations,
  ...publications,
  ...patents,
]
  .filter((item) => item.date)
  .sort((a, b) => {
    const dateDiff = new Date(b.date).getTime() - new Date(a.date).getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.priority - b.priority;
  })
  .slice(0, 4);
---

<section class="w-full mx-auto">
  <h1 class="text-3xl font-bold mb-8 md:mb-[4rem] text-center md:text-left border-b border-border dark:border-darkmode-border">
    News
  </h1>

  <div class="space-y-3">
    {allNews.map((entry) =>
      entry.papers ? (
        <div class="border-b border-border dark:border-darkmode-border pb-3">
          <span class="font-semibold">{entry.type}</span>
          {" — "}
          <span>{entry.title}:</span>
          {entry.papers.map((paper, i) => (
            <>
              {i === 0 ? " " : "; "}
              <a href={paper.link} class="hover:underline italic">{paper.title}</a>
            </>
          ))}
        </div>
      ) : (
        <a
          href={entry.link}
          class="block border-b border-border dark:border-darkmode-border pb-3 hover:underline"
        >
          <span class="font-semibold">{entry.type}</span>
          {" — "}
          <span>{entry.title}</span>
        </a>
      )
    )}
  </div>
</section>