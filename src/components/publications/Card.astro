---
import type { PubEntry } from "@/types";
import { plainify } from "@lib/textConverter";
import { Image } from "astro:assets";
import { FaGlobe } from "react-icons/fa6";
import { FaCode } from "react-icons/fa6";
import { FaRegFilePdf } from "react-icons/fa";
import ExampleImage from "@assets/publications/teasers/example.webp"
import {
  FaTrophy
} from "react-icons/fa";

interface Props {
  entry: PubEntry;
}

const { entry }: Props = Astro.props;
const {
  title,
  authors,
  projectPage,
  projectCode,
  projectPdf,
  imageAlt,
  award,
  keywords = [],
} = entry.data;

const pubImage = entry.data.image ? entry.data.image : ExampleImage;
const publicationVenue = entry.body ? plainify(entry.body) : null;

---

<article class="grid grid-cols-[auto_1fr] gap-3 items-start">
  <div class="relative w-24 aspect-[4/3] overflow-hidden shrink-0">
    <Image
      src={pubImage}
      alt={imageAlt}
      class="w-full h-full object-cover"
      loading="lazy"
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <h4 class="text-base font-bold">{title}</h4>

    {publicationVenue && (
      <p class="text-sm text-gray-500 dark:text-gray-400">{publicationVenue}</p>
    )}

    {award && (
      <p class="text-sm font-bold flex items-center gap-1">
        <FaTrophy className="text-yellow-300 dark:text-yellow-200" />
        {award}
      </p>
    )}

    {authors && (
      <p class="text-sm text-gray-700 dark:text-gray-300">
        {authors.map((author, index) => (
          <Fragment key={index}>
            {author.lab ? <b>{author.name}</b>: author.name}
            {index < authors.length - 1 && ", "}
          </Fragment>
        ))}
      </p>
    )}

    {keywords.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {keywords.map((keyword) => (
          <button
            type="button"
            data-keyword-trigger={keyword}
            aria-pressed="false"
            class="rounded-full border border-border px-3 py-1 text-xs font-medium text-gray-700 transition hover:border-primary hover:text-primary aria-pressed:border-laser aria-pressed:bg-laser aria-pressed:text-black dark:border-darkmode-border dark:text-gray-300 dark:hover:border-darkmode-primary dark:hover:text-darkmode-primary dark:aria-pressed:border-laser dark:aria-pressed:bg-laser dark:aria-pressed:text-black"
          >
            {keyword}
          </button>
        ))}
      </div>
    )}

    <div class="flex gap-4 text-sm text-blue-600 underline items-center">
      {projectPage && (
        <a href={projectPage} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1">
          <FaGlobe /> Project Page
        </a>
      )}
      {projectCode && (
        <a href={projectCode} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1">
          <FaCode /> Code
        </a>
      )}
      {projectPdf && (
        <a href={projectPdf} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1">
          <FaRegFilePdf /> PDF
        </a>
      )}
    </div>
  </div>
</article>
