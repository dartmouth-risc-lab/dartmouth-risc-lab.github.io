---
import ThemeSwitcher from "@components/base/ThemeSwitcher.astro";
import Social from "@components/common/Social.astro";
const { pathname } = Astro.url;
const baseUrl = import.meta.env.BASE_URL;

const stickyHeader = true;

const menu = [
  {
    name: "Home",
    url: baseUrl,
  },
  {
    name: "Publications",
    url: `${baseUrl}publications`,
  },
  {
    name: "People",
    url: `${baseUrl}people`,
  },
  {
    name: "Awards",
    url: `${baseUrl}awards`,
  },
  {
    name: "Presentations",
    url: `${baseUrl}presentations`,
  },
  {
    name: "Outreach",
    url: `${baseUrl}outreach`,
  },
  {
  name: "Patents",
  url: `${baseUrl}patents`,
  }, 
  {
  name: "Resources",
  url: `${baseUrl}resources`,
  },
  {
  name: "News",
  url: `${baseUrl}news`,
  }
];
---

<header
  transition:persist
  class={`bg-bg-p dark:bg-darkmode-bg-p container py-2 z-30 mb-3 md:mb-6 lg:mt-8 ${stickyHeader && "sticky top-0"}` }
>
  <nav class="relative flex flex-wrap items-center justify-between">
    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      for="nav-toggle"
      class="order-0 cursor-pointer flex items-center lg:hidden text-txt-p dark:text-darkmode-txt-p lg:order-1"
    >
      <svg id="show-button" class="h-6 fill-current block" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg id="hide-button" class="h-6 fill-current hidden" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>
    <!-- /navbar toggler -->
    <ul
      id="nav-menu"
      class="text-center justify-center order-1 hidden w-full pb-6 lg:order-2 lg:flex lg:w-auto lg:pb-0 lg:space-x-4"
    >
      {
        menu.map((item) => (
          <li class="border-b border-border dark:border-darkmode-border md:border-none">
            <a
              href={item.url}
              class={`block p-2 text-lg font-primary font-semibold text-txt-p transition dark:text-darkmode-txt-p lg:px-2 lg:py-3 ${
                (pathname === `${item.url}/` || pathname === item.url) &&
                "active"
              }`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="text-center order-2 lg:order-1 lg:my-0 flex items-center justify-center ">
      <Social
        links={{
          youtube: "https://youtube.com/@risc-lab-dartmouth?si=p3y_LFPQIwpu5-9W",
          github: "https://github.com/dartmouth-risc-lab",
          email: "risc-lab-group@dartmouth.edu"
        }}
      />
    </div>
    <div class="order-3 flex items-center md:order-3 lg:ml-0">
      <ThemeSwitcher />
    </div>
  </nav>
</header>

<script is:inline>
  // Auto-close the mobile nav menu when a link is tapped. The header uses
  // transition:persist, so the toggle checkbox would otherwise stay checked
  // (menu open) across view transitions.
  function setupNavAutoClose() {
    const menu = document.getElementById("nav-menu");
    const toggle = document.getElementById("nav-toggle");
    if (!menu || !toggle || menu.dataset.autoClose === "true") return;
    menu.dataset.autoClose = "true";
    menu.addEventListener("click", (e) => {
      if (e.target.closest("a")) {
        toggle.checked = false;
      }
    });
  }
  setupNavAutoClose();
  document.addEventListener("astro:after-swap", setupNavAutoClose);
</script>
