---
import { Image } from 'astro:assets';

// Load publication teaser images, including year-grouped folders.
const publicationTeasers = import.meta.glob('@assets/publications/teasers/**/*.{webp,png,jpg,jpeg}', {
  eager: true
});

const labPhotos = import.meta.glob('@assets/lab-photos/*.{webp,png,jpg,jpeg}', {
  eager: true
});

const images = [
  ...Object.values(labPhotos),
  ...Object.values(publicationTeasers),
];
---

<style>
  .carousel {
    @apply absolute w-screen h-[15rem] md:h-[20rem] lg:h-[23rem] xl:h-[30rem] overflow-hidden;
    top: 7.75rem;
    left: 0px;
    z-index: -100;
  }

  .carousel img {
    @apply absolute top-0 left-0 w-full h-[15rem] md:h-[20rem] lg:h-[23rem] xl:h-full object-cover opacity-0 transition-opacity duration-[3000ms] ease-in-out;
    filter: blur(0px) brightness(0.15) saturate(0.75);
    transform: scale(1.03);
  }

  .carousel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.50);
    z-index: 5;
  }

  .carousel img.active {
    @apply opacity-100 z-10;
  }
</style>

<div class="carousel">
  {images.map((image, idx) => (
    <Image
      src={image.default}
      alt={`Banner ${idx + 1}`}
      class={idx === 0 ? 'active' : ''}
      data-idx={idx}
    />
  ))}

<script is:inline>
  function startCarousel() {
    const images = document.querySelectorAll(".carousel img");
    if (!images.length) return;

    let current = 0;

    images.forEach((img, i) => {
      img.classList.remove("active");
      if (i === 0) img.classList.add("active");
    });

    clearInterval(window.carouselInterval);

    window.carouselInterval = setInterval(() => {
      images[current].classList.remove("active");
      current = (current + 1) % images.length;
      images[current].classList.add("active");
    }, 5000);
  }

  startCarousel();
  document.addEventListener("astro:after-swap", startCarousel);
</script>

</div>
