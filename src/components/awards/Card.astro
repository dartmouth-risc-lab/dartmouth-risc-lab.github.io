---
import type { AwardEntry } from "@/types";
import { plainify } from "@lib/textConverter";

interface Props {
  entry: AwardEntry;
}

const { entry }: Props = Astro.props;
const { title, awardLink, year, recipient } = entry.data;
const bodyBrief = entry.body ? plainify(entry.body) : null;
---

<div class="border-b border-border dark:border-darkmode-border py-3">
  <p class="text-base">
    <span class="font-semibold">{year}</span>
    {" — "}
    {awardLink ? (
      <a href={awardLink} target="_blank" rel="noopener noreferrer" class="font-semibold hover:underline">
        {title}
      </a>
    ) : (
      <span class="font-semibold">{title}</span>
    )}
    {recipient && <> — {recipient}</>}
    {bodyBrief && <> — {bodyBrief}</>}
  </p>
</div>