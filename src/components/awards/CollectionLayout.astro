---
import { getEntry } from "astro:content";

const entry = await getEntry("awards", "awards");
const awards = entry?.data.awards ?? [];

awards.sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<section class="w-full mx-auto">
  <h1 class="text-5xl font-bold mb-12 text-center">Awards & Recognition</h1>

  <div class="space-y-1">
    {awards.map((award) => (
  <p class="border-b border-border dark:border-darkmode-border py-3 text-base">
    {award.awardLink ? (
      <a
        href={award.awardLink}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold hover:underline"
      >
        {award.title}
      </a>
    ) : (
      <span class="font-semibold">{award.title}</span>
    )}
    {" — "}
    <span>{award.recipient}</span>
    {" — "}
    <span>{award.result}</span>
  </p>
))}
  </div>
</section>