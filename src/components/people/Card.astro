---
import type { PeopleEntry } from "@/types";
import { plainify } from "@lib/textConverter";
import { Image } from "astro:assets";
import defaultImage from "@/assets/people/example.webp";
import { FaExternalLinkAlt } from "react-icons/fa";

interface Props {
  entry: PeopleEntry;
  compact?: boolean;
  listOnly?: boolean;
  roleLabel?: string;
  formerLabel?: string;
}

const { entry, compact = false, listOnly = false, roleLabel = "", formerLabel = "" }: Props = Astro.props;

const { title, imageAlt, startDate, endDate, pronouns, social, nextStop, affiliation } = entry.data;
const image = entry.data.image ?? defaultImage;

const bodyBrief = entry.body ? plainify(entry.body?.slice(0, 100)) : null;
const personalLink = social?.website ?? Object.values(social ?? {}).find(Boolean) ?? null;

const formatDate = (date?: string) => {
  if (!date) return "Present";
  return new Date(date).toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
};

const timeFrame = `${formatDate(startDate)} – ${endDate ? formatDate(endDate) : "Present"}`;
const label = [formerLabel, roleLabel].filter(Boolean).join(" ");
---

{listOnly ? (
  <div class="border-b border-border dark:border-darkmode-border py-2 text-sm">
    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
      {personalLink ? (
        <a href={personalLink} target="_blank" rel="noopener noreferrer" class="font-semibold hover:underline">
          {title}
        </a>
      ) : (
        <span class="font-semibold">{title}</span>
      )}

      {personalLink && <FaExternalLinkAlt className="w-3 h-3 opacity-60" />}

      {label && <span class="opacity-70">— {label}</span>}
      {affiliation && <span class="opacity-70">— {affiliation}</span>}
      <span class="opacity-70">— {timeFrame}</span>
      {nextStop && <span class="opacity-70">— {nextStop}</span>}
    </div>
  </div>
) : (
  <div class={compact ? "w-[7rem] mb-6" : "w-[8rem] mb-6"}>
    <div class="p-1 text-center intersect:animate-fadeUp opacity-0">
      {image && (
        <div class={compact
          ? "rounded-full w-[5rem] h-[5rem] overflow-hidden md:w-[6.5rem] md:h-[6.5rem] mx-auto"
          : "rounded-full w-[6rem] h-[6rem] overflow-hidden md:w-[8rem] md:h-[8rem] mx-auto"
        }>
          <Image
            src={image}
            alt={imageAlt}
            widths={[200, 300, 400]}
            sizes="(max-width: 768px) 200px, 300px"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <div class="flex items-center justify-center gap-1 mt-3">
        <h4 class={compact ? "mb-0 font-primary text-base leading-tight" : "mb-0 font-primary text-lg leading-tight"}>
          {personalLink ? (
            <a href={personalLink} target="_blank" rel="noopener noreferrer" class="hover:underline">
              {title}
            </a>
          ) : (
            title
          )}
        </h4>

        {personalLink && (
          <a href={personalLink} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-black">
            <FaExternalLinkAlt className="w-3 h-3" />
          </a>
        )}
      </div>

      {pronouns && <p class="mb-1 text-xs text-gray-500">({pronouns})</p>}
      <p class="mb-1 text-xs opacity-70">{timeFrame}</p>
      {affiliation && <p class="mb-1 text-xs opacity-70">{affiliation}</p>}
      {bodyBrief && <p class="mb-1 text-xs">{bodyBrief}</p>}
    </div>
  </div>
)}