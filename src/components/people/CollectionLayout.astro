---
import type { PeopleEntry } from "@/types";
import BaseLayout from "@components/base/BaseLayout.astro";
import StudentCard from "@components/people/Card.astro";
import ProfessorCard from "@components/people/ProfessorCard.astro";

interface Props {
  peopleIndex: PeopleEntry;
  entries: PeopleEntry[];
}

const { entries } = Astro.props;

const today = new Date();

const roleLabels = {
  postdoc: "Postdoc",
  phd: "PhD",
  masters: "Masters",
  undergraduates: "Undergraduate",
  visitors: "Visitors",
};

const getFolder = (entry) => entry.id.split("/")[0];

const isFormer = (entry) => {
  if (!entry.data.endDate) return false;
  return new Date(entry.data.endDate) < today;
};

const sortByStartDateAsc = (a, b) =>
  new Date(a.data.startDate).getTime() - new Date(b.data.startDate).getTime();

const sortByStartDateDesc = (a, b) =>
  new Date(b.data.startDate).getTime() - new Date(a.data.startDate).getTime();

const sortByEndDateDesc = (a, b) =>
  new Date(b.data.endDate).getTime() - new Date(a.data.endDate).getTime();

const professors = entries
  .filter((entry) => getFolder(entry) === "professors")
  .sort(sortByStartDateAsc);

const currentByFolder = (folder) =>
  entries
    .filter((entry) => getFolder(entry) === folder && !isFormer(entry))
    .sort(sortByStartDateAsc);

const currentPostdocs = currentByFolder("postdoc");
const currentPhds = currentByFolder("phd");
const currentMasters = currentByFolder("masters");
const currentUndergraduates = currentByFolder("undergraduates");

const visitors = entries
  .filter((entry) => getFolder(entry) === "visitors")
  .sort(sortByStartDateDesc);

const alumniByFolder = (folder) =>
  entries
    .filter(
      (entry) =>
        isFormer(entry) &&
        getFolder(entry) === folder &&
        entry.data.status === "graduated"
    )
    .sort(sortByEndDateDesc);

const phdAlumni = alumniByFolder("phd");
const postdocAlumni = alumniByFolder("postdoc");
const mastersAlumni = alumniByFolder("masters");
const undergraduateAlumni = alumniByFolder("undergraduates");

const formerMembers = entries
  .filter(
    (entry) =>
      isFormer(entry) &&
      getFolder(entry) !== "visitors" &&
      entry.data.status !== "graduated"
  )
  .sort(sortByEndDateDesc);
---

<BaseLayout title="People" description="RISc Lab members">
  <section class="section-sm pb-0">
    <div class="container">
      <div class="text-center mb-8 flex flex-wrap justify-center gap-x-4 gap-y-2">
        {postdocAlumni.length > 0 && <a href="#postdoc-alumni" class="text-sm underline opacity-80 hover:opacity-100">Postdoc Alumni</a>}
        {phdAlumni.length > 0 && <a href="#phd-alumni" class="text-sm underline opacity-80 hover:opacity-100">PhD Alumni</a>}
        {mastersAlumni.length > 0 && <a href="#masters-alumni" class="text-sm underline opacity-80 hover:opacity-100">Masters Alumni</a>}
        {undergraduateAlumni.length > 0 && <a href="#undergraduate-alumni" class="text-sm underline opacity-80 hover:opacity-100">Undergraduate Alumni</a>}
        {visitors.length > 0 && <a href="#visitors" class="text-sm underline opacity-80 hover:opacity-100">Visitors</a>}
        {formerMembers.length > 0 && <a href="#former-members" class="text-sm underline opacity-80 hover:opacity-100">Former Members</a>}
      </div>

      <h2 class="text-2xl text-center font-semibold mb-8 border-b border-border dark:border-darkmode-border">
        Principal Investigator
      </h2>
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-6">
        {professors.map((entry) => <ProfessorCard entry={entry} />)}
      </div>

      {(currentPostdocs.length > 0 || currentPhds.length > 0) && (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 md:mx-[6rem] mt-8">
          {currentPostdocs.length > 0 && (
            <section>
              <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
                Postdocs
              </h2>
              <div class="flex flex-wrap justify-center gap-x-8 gap-y-6">
                {currentPostdocs.map((entry) => <StudentCard entry={entry} />)}
              </div>
            </section>
          )}

          {currentPhds.length > 0 && (
            <section>
              <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
                PhD Students
              </h2>
              <div class="flex flex-wrap justify-center gap-x-8 gap-y-6">
                {currentPhds.map((entry) => <StudentCard entry={entry} />)}
              </div>
            </section>
          )}
        </div>
      )}

      {(currentMasters.length > 0 || currentUndergraduates.length > 0) && (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 md:mx-[6rem] mt-12">
          {currentMasters.length > 0 && (
            <section>
              <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
                Masters Students
              </h2>
              <div class="flex flex-wrap justify-center gap-x-6 gap-y-5">
                {currentMasters.map((entry) => <StudentCard entry={entry} compact />)}
              </div>
            </section>
          )}

          {currentUndergraduates.length > 0 && (
            <section>
              <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
                Undergraduates
              </h2>
              <div class="flex flex-wrap justify-center gap-x-6 gap-y-5">
                {currentUndergraduates.map((entry) => <StudentCard entry={entry} compact />)}
              </div>
            </section>
          )}
        </div>
      )}


      {postdocAlumni.length > 0 && (
        <section id="postdoc-alumni" class="md:mx-[6rem] mt-16">
          <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
            Postdoc Alumni
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {postdocAlumni.map((entry) => (
              <StudentCard entry={entry} listOnly />
            ))}
          </div>
        </section>
      )}

      {phdAlumni.length > 0 && (
        <section id="phd-alumni" class="md:mx-[6rem] mt-16">
          <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
            PhD Alumni
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {phdAlumni.map((entry) => (
              <StudentCard entry={entry} listOnly />
            ))}
          </div>
        </section>
      )}

      {mastersAlumni.length > 0 && (
        <section id="masters-alumni" class="md:mx-[6rem] mt-12">
          <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
            Masters Alumni
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {mastersAlumni.map((entry) => (
              <StudentCard entry={entry} listOnly />
            ))}
          </div>
        </section>
      )}

      {undergraduateAlumni.length > 0 && (
        <section id="undergraduate-alumni" class="md:mx-[6rem] mt-12">
          <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
            Undergraduate Alumni
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {undergraduateAlumni.map((entry) => (
              <StudentCard entry={entry} listOnly />
            ))}
          </div>
        </section>
      )}

       {visitors.length > 0 && (
        <section id="visitors" class="md:mx-[6rem] mt-12">
          <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
            Visitors
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {visitors.map((entry) => (
              <StudentCard entry={entry} listOnly />
            ))}
          </div>
        </section>
      )}
      
      {formerMembers.length > 0 && (
        <section id="former-members" class="md:mx-[6rem] mt-12">
          <h2 class="text-2xl font-semibold mb-6 border-b border-border dark:border-darkmode-border">
            Former Members
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {formerMembers.map((entry) => (
              <StudentCard
                entry={entry}
                listOnly
              />
            ))}
          </div>
        </section>
      )}

     
    </div>
  </section>
</BaseLayout>
